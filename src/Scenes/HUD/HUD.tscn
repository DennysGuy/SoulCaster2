[node name="ContextLabel" type="Label" parent="ContextPanel" unique_id=1440265021]
layout_mode = 0
offset_left = 11.0
offset_top = 6.0
offset_right = 602.0
offset_bottom = 394.0
theme_override_font_sizes/font_size = 14
text = "** ATTENTION! READ THOROUGHLY TO UNDERSTAND RULES! ***
Survive the Rat Barrage; Defeat the Mother Rat! 

Directions:
1. Your Health is the Timer (the big number towards the top of the screen)! Kill enemies to regain time!
2. The purple Progress Bar at the top represents the current round's progress. 
3. The bar will fill automatically while you fight rats. 
4. Once the progress bar fills completely, you will be moved to the next round. 
5. If the timer runs out before the end of the round, you will be sent back to the hub.

Controls:

WASD - Move Camera
Mouse - Aim Weapon
Left Click - Fire Weapon
R - Reload

*Shoot and destroy the rocks to acquire ore
to spend at shop*"

